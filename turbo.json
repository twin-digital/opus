{
  "$schema": "./node_modules/turbo/schema.json",
  "concurrency": "2",
  "globalPassThroughEnv": ["CI"],
  "globalDependencies": [
    ".prettierrc",
    ".prettierignore",
    "nodejs/devtools/tsconfig/tsconfig.json",
    "nodejs/devtools/tsconfig/tsconfig.build.json"
  ],
  "tasks": {
    "artifact": {
      "dependsOn": ["build"],
      "inputs": ["assets/**", "Dockerfile", "package.json", "src/**", "tsconfig.json", "tsconfig.*.json"],
      "outputs": [".out/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "assets/**",
        "index.html",
        "package.json",
        "src/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "tsdown.config.ts",
        "vite.config.ts",
        "vite.config.d/**"
      ],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "deploy:serverless": {
      "cache": false,
      "dependsOn": ["build", "^deploy:serverless"],
      "passThroughEnv": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "SERVERLESS_ACCESS_KEY"]
    },
    "deploy:cdk": {
      "cache": false,
      "dependsOn": ["build", "^deploy:cdk"],
      "passThroughEnv": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN"]
    },
    "destroy:serverless": {
      "cache": false,
      "passThroughEnv": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "SERVERLESS_ACCESS_KEY"]
    },
    "destroy:cdk": {
      "cache": false,
      "passThroughEnv": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true,
      "passThroughEnv": [
        "DOCKER_CERT_PATH",
        "DOCKER_CONFIG",
        "DOCKER_CONTEXT",
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "SSH_AGENT_PID",
        "SSH_AUTH_SOCK"
      ]
    },
    "lint": {
      "dependsOn": ["upstream-sources", "@twin-digital/eslint-config#build", "//#lint:deps"],
      "inputs": ["eslint.config.js", "package.json", "src/**"]
    },
    "@twin-digital/credential-shelf-trigger#lint": {
      "dependsOn": ["upstream-sources", "@twin-digital/eslint-config#build", "//#lint:deps", "build"],
      "inputs": ["eslint.config.js", "package.json", "src/**", "bin/**"]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["upstream-sources", "@twin-digital/eslint-config#build"]
    },
    "//#lint:deps": {
      "inputs": ["**/package.json", "pnpm-workspace.yaml"]
    },
    "release-assets": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["upstream-sources", "@twin-digital/vitest-config#build"],
      "inputs": [
        "src/**",
        "behavior_pack/**",
        "package.json",
        "vitest.config.ts",
        "vitest.config.d/**",
        "tsconfig.json",
        "tsconfig.*.json"
      ],
      "outputs": ["coverage.json"]
    },
    "@thrashplay/wishem-host-nodejs#test": {
      "dependsOn": ["upstream-sources", "@twin-digital/vitest-config#build", "^build", "build"],
      "inputs": [
        "src/**",
        "behavior_pack/**",
        "package.json",
        "vitest.config.ts",
        "vitest.config.d/**",
        "tsconfig.json",
        "tsconfig.*.json"
      ],
      "outputs": ["coverage.json"]
    },
    "@thrashplay/wishem-docs-check#test": {
      "dependsOn": ["upstream-sources", "@twin-digital/vitest-config#build"],
      "inputs": [
        "src/**",
        "package.json",
        "vitest.config.ts",
        "vitest.config.d/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/nodejs/wishem/*/package.json",
        "$TURBO_ROOT$/nodejs/wishem/docs/architecture/**",
        "$TURBO_ROOT$/nodejs/wishem/workbench-app/src/styles/tokens.css"
      ],
      "outputs": ["coverage.json"]
    },
    "@thrashplay/wishem-workbench#test": {
      "dependsOn": ["upstream-sources", "@twin-digital/vitest-config#build", "^build"],
      "inputs": [
        "src/**",
        "model/**",
        "behavior_pack/**",
        "package.json",
        "vitest.config.ts",
        "vitest.config.d/**",
        "tsconfig.json",
        "tsconfig.*.json"
      ],
      "outputs": ["coverage.json"]
    },
    "@thrashplay/wishem-workbench-app#test": {
      "dependsOn": ["upstream-sources", "@twin-digital/vitest-config#build", "^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "index.html",
        "package.json",
        "vite.config.ts",
        "vite.config.d/**",
        "vitest.config.ts",
        "vitest.config.d/**",
        "$TURBO_ROOT$/nodejs/wishem/workbench/model/**",
        "tsconfig.json",
        "tsconfig.*.json"
      ],
      "outputs": ["coverage.json"]
    },
    "test:ui": {
      "dependsOn": ["upstream-sources", "^build"],
      "inputs": [
        "index.html",
        "package.json",
        "playwright.config.ts",
        "scripts/**",
        "$TURBO_ROOT$/nodejs/wishem/workbench/model/**",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "src/**",
        "style-guide.html",
        "tests/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "vite.config.ts",
        "vite.config.d/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "DOCKER_CERT_PATH",
        "DOCKER_CONFIG",
        "DOCKER_CONTEXT",
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "SSH_AGENT_PID",
        "SSH_AUTH_SOCK",
        "WISHEM_BROWSER_HOST"
      ]
    },
    "@thrashplay/wishem-renderer-godot#test:ui": {
      "dependsOn": ["upstream-sources", "^build"],
      "inputs": [
        "package.json",
        "scripts/**",
        "$TURBO_ROOT$/nodejs/wishem/workbench/model/**",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "src/**",
        "tests/**",
        "tsconfig.json",
        "tsconfig.*.json",
        "godot/**",
        "docker/**"
      ],
      "outputs": [],
      "passThroughEnv": [
        "DOCKER_CERT_PATH",
        "DOCKER_CONFIG",
        "DOCKER_CONTEXT",
        "DOCKER_HOST",
        "DOCKER_TLS_VERIFY",
        "SSH_AGENT_PID",
        "SSH_AUTH_SOCK",
        "WISHEM_BROWSER_HOST"
      ]
    },
    "test:watch": {
      "dependsOn": ["@twin-digital/vitest-config#build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["upstream-sources"],
      "inputs": ["package.json", "tsconfig.json", "tsconfig.*.json", "src/**"],
      "outputs": []
    },
    "@twin-digital/credential-shelf#typecheck": {
      "dependsOn": ["upstream-sources", "build"],
      "inputs": ["package.json", "tsconfig.json", "tsconfig.*.json", "src/**", "bin/**"],
      "outputs": []
    },
    "@twin-digital/credential-shelf-trigger#typecheck": {
      "dependsOn": ["upstream-sources", "build"],
      "inputs": ["package.json", "tsconfig.json", "tsconfig.*.json", "src/**", "bin/**"],
      "outputs": []
    },
    "upstream-sources": {
      "dependsOn": ["^upstream-sources"]
    },
    "watch": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    }
  }
}

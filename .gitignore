########################################################################################################################
# Project-specific
########################################################################################################################

# scratch area
tmp

# build outputs
.out

# per-package GitHub release assets (see the release-assets script hook)
.release-assets

# test outputs
coverage
coverage.json

# runtime outputs
nodejs/dolmenwood/dolmenwood-bot/.data
nodejs/dolmenwood/refbash/.data
.bookify-tmp

# only add shareable .claude artifacts
.claude/*
!.claude/*.example
!.claude/agents
!.claude/CLAUDE.md
!.claude/hooks
!.claude/settings.json
!.claude/skills
# do not ignore .claude directories in nested directories, since these are custom configs, skills, etc.
!*/**/.claude


# Core dumps. A type-aware lint over a large package can exhaust its heap and
# leave one of these — multi-gigabyte, and large enough that git accepts it and
# the remote then refuses the push. The suffix is the dumping pid, so match
# digits only: a bare `core.*` also swallows source files named core.ts.
core
core.[0-9]*

{
  "name": "@twin-digital/mc-dev-server",
  "version": "0.2.0",
  "description": "Runs a Minecraft Bedrock dev server under Docker and keeps a workspace's built packs deployed to it.",
  "license": "ISC",
  "type": "module",
  "bin": {
    "minecraft-server": "./bin/minecraft-server.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "build",
    "clean": "clean",
    "lint": "lint",
    "lint:fix": "lint_fix",
    "test": "opus-test",
    "test:watch": "opus-test-watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@twin-digital/mc-dev-kit": "workspace:*",
    "ajv": "catalog:",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "execa": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@twin-digital/eslint-config": "workspace:*",
    "@twin-digital/opus-scripts": "workspace:*",
    "@twin-digital/tsconfig": "workspace:*",
    "@twin-digital/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-package-json": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}

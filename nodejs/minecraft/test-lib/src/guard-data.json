{
  "$comment": [
    "What each member of a faked class does when its owner is invalid, transcribed from the",
    "reflective sweeps of the engine (f:invalidation-guard-list-complete,",
    "f:attribute-guard-classes-observed, f:effect-members-throw-plain-error). This is an input to",
    "tools/generate.ts, which writes the matching prologue into every generated member.",
    "",
    "A shape is one of: none (readable), invalid-entity-get, invalid-entity-set,",
    "invalid-entity-call (InvalidEntityError, whose message names that access shape),",
    "failed-property[:internalName] and failed-call[:name] (a plain Error). An override may name",
    "the string the engine puts in the message where it differs from the member's own name.",
    "",
    "The entityComponent table — the other 61 components — is the one table without a sweep behind",
    "it: it follows the declarations' own @throws split, which leaves isValid and typeId unannotated",
    "and names InvalidEntityError everywhere else."
  ],
  "tables": {
    "entity": {
      "readable": ["id", "isValid", "typeId", "scoreboardIdentity"],
      "defaultProperty": "invalid-entity-get",
      "defaultMethod": "invalid-entity-call",
      "overrides": {
        "nameTag": "invalid-entity-set",
        "localizationKey": "invalid-entity-call"
      }
    },
    "attributeComponent": {
      "readable": ["isValid", "typeId"],
      "defaultProperty": "invalid-entity-get",
      "defaultMethod": "invalid-entity-call",
      "overrides": {
        "currentValue": "failed-property:current",
        "defaultValue": "failed-property:value",
        "effectiveMax": "failed-property:effectiveMaxValue",
        "effectiveMin": "failed-property:effectiveMinValue",
        "resetToDefaultValue": "failed-call",
        "resetToMaxValue": "failed-call",
        "resetToMinValue": "failed-call",
        "setCurrentValue": "invalid-entity-set:setCurrent",
        "entity": "invalid-entity-get"
      }
    },
    "entityComponent": {
      "readable": ["isValid", "typeId"],
      "defaultProperty": "invalid-entity-get",
      "defaultMethod": "invalid-entity-call",
      "overrides": {}
    },
    "effect": {
      "readable": ["isValid"],
      "defaultProperty": "failed-property",
      "defaultMethod": "failed-call",
      "overrides": {}
    }
  },
  "assignments": {
    "Entity": "entity",
    "Player": "entity",
    "Effect": "effect"
  },
  "attributeComponentClasses": [
    "EntityExhaustionComponent",
    "EntityHealthComponent",
    "EntityHungerComponent",
    "EntityLavaMovementComponent",
    "EntityMovementComponent",
    "EntitySaturationComponent",
    "EntityUnderwaterMovementComponent"
  ]
}

{
  "name": "@twin-digital/mc-dev-kit",
  "version": "0.3.1",
  "description": "Discovers the Minecraft Bedrock packs in a workspace and reports each one validated and completed.",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "./index": null,
    "./index.js": null,
    "./*": {
      "import": {
        "source": "./src/*.ts",
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    },
    "./build": {
      "import": {
        "source": "./src/build.ts",
        "types": "./dist/build.d.ts",
        "import": "./dist/build.js"
      }
    }
  },
  "bin": {
    "mc-pack-archive": "./bin/mc-pack-archive.js"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "build",
    "clean": "clean",
    "lint": "lint",
    "lint:fix": "lint_fix",
    "test": "opus-test",
    "test:watch": "opus-test-watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@npmcli/map-workspaces": "^6.0.0",
    "@pnpm/workspace.find-packages": "^1000.0.65",
    "@pnpm/workspace.read-manifest": "^1000.1.7",
    "@twin-digital/mc-pack-runtime": "workspace:*",
    "adm-zip": "^0.6.0",
    "semver": "^7.7.3",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@twin-digital/eslint-config": "workspace:*",
    "@twin-digital/opus-scripts": "workspace:*",
    "@twin-digital/tsconfig": "workspace:*",
    "@twin-digital/tsdown-config": "workspace:*",
    "@twin-digital/vitest-config": "workspace:*",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "catalog:",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-istanbul": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-package-json": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}

{
  "private": true,
  "name": "@thrashplay/wishem-workbench-app",
  "version": "0.0.0",
  "description": "The Wishem workbench application: design tokens, components, and the style guide.",
  "type": "module",
  "scripts": {
    "build": "build",
    "clean": "clean",
    "dev": "vite --host",
    "generate": "node scripts/generate.ts",
    "lint": "lint",
    "lint:fix": "lint_fix",
    "preview": "vite preview",
    "start": "exec node scripts/start.ts",
    "style-guide": "vite --open /style-guide.html",
    "test": "opus-test",
    "test:ui": "node scripts/browser-server.ts playwright test",
    "test:ui:update": "node scripts/browser-server.ts playwright test --update-snapshots",
    "test:watch": "opus-test-watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@thrashplay/wishem-clock": "workspace:*",
    "@thrashplay/wishem-construct-manager": "workspace:*",
    "@thrashplay/wishem-core": "workspace:*",
    "@thrashplay/wishem-host-nodejs": "workspace:*",
    "@thrashplay/wishem-hub": "workspace:*",
    "@thrashplay/wishem-renderer-react": "workspace:*",
    "@thrashplay/wishem-update": "workspace:*",
    "@thrashplay/wishem-workbench": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@eslint/js": "catalog:",
    "@fontsource-variable/bricolage-grotesque": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource/jetbrains-mono": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@thrashplay/wishem-sample-product": "workspace:*",
    "@twin-digital/eslint-config": "workspace:*",
    "@twin-digital/opus-scripts": "workspace:*",
    "@twin-digital/tsconfig": "workspace:*",
    "@twin-digital/vite-config": "workspace:*",
    "@twin-digital/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "catalog:",
    "jsdom": "^30.0.0",
    "prettier": "catalog:",
    "prettier-package-json": "catalog:",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}

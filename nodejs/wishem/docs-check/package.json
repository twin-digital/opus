{
  "private": true,
  "name": "@thrashplay/wishem-docs-check",
  "version": "0.0.0",
  "description": "Tests that the architecture document of Wishem agrees with the packages.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "./index": null,
    "./index.js": null,
    "./*": {
      "import": {
        "source": "./src/*.ts",
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "build",
    "clean": "clean",
    "lint": "lint",
    "lint:fix": "lint_fix",
    "test": "opus-test",
    "test:watch": "opus-test-watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@thrashplay/wishem-clock": "workspace:*",
    "@thrashplay/wishem-construct-manager": "workspace:*",
    "@thrashplay/wishem-core": "workspace:*",
    "@thrashplay/wishem-host-nodejs": "workspace:*",
    "@thrashplay/wishem-hub": "workspace:*",
    "@thrashplay/wishem-pixi-page": "workspace:*",
    "@thrashplay/wishem-renderer-godot": "workspace:*",
    "@thrashplay/wishem-renderer-pixi": "workspace:*",
    "@thrashplay/wishem-renderer-react": "workspace:*",
    "@thrashplay/wishem-sample-product": "workspace:*",
    "@thrashplay/wishem-three-renderers": "workspace:*",
    "@thrashplay/wishem-update": "workspace:*",
    "@thrashplay/wishem-workbench": "workspace:*",
    "@thrashplay/wishem-workbench-app": "workspace:*",
    "@twin-digital/eslint-config": "workspace:*",
    "@twin-digital/opus-scripts": "workspace:*",
    "@twin-digital/tsconfig": "workspace:*",
    "@twin-digital/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-package-json": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}

{
  "compilerOptions": {
    "jsx": "react-jsx",
    // Node.js runs scripts/*.ts by type stripping, which allows erasable syntax only.
    "erasableSyntaxOnly": true,
    // Sources import each other with the `.ts` extension, as Node.js needs. The build rewrites it to `.js`.
    "rewriteRelativeImportExtensions": true
  }
}
